#!/bin/sh
#
# @name Gazebo x500 tag camera (drone_sim)
#
# @type Quadrotor
#
# x500 (4001) flown on ground-truth external vision only: no GPS, baro or mag in EKF2, no RC needed.
# Verified param names/values against PX4 v1.16.2 (src/modules/ekf2/*.yaml, commander_params.c).

PX4_SIM_MODEL=${PX4_SIM_MODEL:=gz_x500}

. ${R}etc/init.d-posix/airframes/4001_gz_x500

# --- EKF2: fuse external vision (pos + vel + yaw), height reference = vision
param set-default EKF2_EV_CTRL 15        # bit0 horiz pos, bit1 vert pos, bit2 3D vel, bit3 yaw
param set-default EKF2_HGT_REF 3         # 0 baro, 1 GPS, 2 range, 3 vision
param set-default EKF2_GPS_CTRL 0        # GNSS fusion off
param set-default EKF2_BARO_CTRL 0       # baro fusion off (boolean)
param set-default EKF2_MAG_TYPE 5        # none (yaw from EV)
param set-default EKF2_EV_DELAY 10       # ms, GT arrives over DDS a few ms after the sample
param set-default EKF2_EVP_NOISE 0.01    # m
param set-default EKF2_EVV_NOISE 0.02    # m/s
param set-default EKF2_EVA_NOISE 0.02    # rad
param set-default EKF2_EV_NOISE_MD 0     # use the fixed noise params above, not the message variances
param set-default SYS_HAS_MAG 0          # no preflight mag requirement

# --- Arming / failsafes without RC, GCS or GPS
param set-default COM_RC_IN_MODE 4       # ignore stick input (no RC-loss failsafe)
param set-default NAV_RCL_ACT 0          # RC loss action: disabled
param set-default COM_RCL_EXCEPT 4       # RC loss ignored in offboard
param set-default COM_ARM_WO_GPS 1       # allow arming without GPS
param set-default NAV_DLL_ACT 0          # no GCS: data link loss action disabled (4001 sets 2)
param set-default COM_DISARM_PRFLT 60    # do not auto-disarm if takeoff starts late
param set-default COM_OF_LOSS_T 1.0      # offboard signal loss timeout (s)
